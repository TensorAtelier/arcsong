#!/usr/bin/env bash
# Release QA: journeys 1–5 from docs/product/product.md in a private headless Chrome against a
# fresh fake-Engine server (port 8851, a temp data dir). Needs Node and Google Chrome.
#   scripts/release-qa            # exit 0 when every journey passes
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/.." && pwd)"
chrome="${CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
port="${CDP_PORT:-9334}"
if curl -sf "http://127.0.0.1:$port/json/version" >/dev/null; then
  echo "port $port already has a DevTools endpoint; set CDP_PORT to a free port" >&2
  exit 2
fi
profile="$(mktemp -d)"
"$chrome" --headless=new --remote-debugging-port="$port" --user-data-dir="$profile" \
  --no-first-run --hide-scrollbars --autoplay-policy=no-user-gesture-required about:blank \
  >"$profile.log" 2>&1 &
browser=$!
trap 'kill $browser 2>/dev/null || true; wait $browser 2>/dev/null || true; rm -rf "$profile" "$profile.log"' EXIT
ready=""
for _ in $(seq 1 150); do  # up to 30 s: a cold CI runner can take more than 10
  curl -sf "http://127.0.0.1:$port/json/version" >/dev/null && { ready=1; break; }
  sleep 0.2
done
[ -n "$ready" ] || { echo "Chrome did not start ($chrome):" >&2; tail -20 "$profile.log" >&2; exit 2; }
CDP="http://127.0.0.1:$port" node "$here/release_qa/release-qa.mjs" "$repo"
